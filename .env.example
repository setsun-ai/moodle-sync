# moodle-sync configuration. The easiest way to fill it in:  python -m moodle_sync setup
# Full description of every option: docs/en/configuration.md (PL: docs/pl/configuration.md)
# This file holds secrets (tokens) - never commit or share it. It's in .gitignore.

# --- required -------------------------------------------------------------------
MOODLE_BASE_URL=https://moodle.example.edu
MOODLE_TOKEN=

# --- general ---------------------------------------------------------------------
LANGUAGE=en                   # en | pl - messages, notifications, bot, folder names
SITE_LABEL=Moodle             # short school name used in calendar names, e.g. UNI
# MOODLE_LANG=en              # which variant to keep from {mlang pl}..{mlang en}.. names (default: LANGUAGE)
# TIMEZONE=Europe/Warsaw      # IANA time zone for calendars (default: Europe/Warsaw for pl, UTC for en)

# --- files ----------------------------------------------------------------------
DOWNLOAD_DIR=downloads        # relative to the project, or absolute (e.g. inside your OneDrive folder)
# MAX_FILE_MB=0               # skip files bigger than N MB (0 = no limit)

# --- semesters and subject cards (optional; docs: configuration.md) ---------------
# STUDY_PLAN_URL=            # your field of study in the ECTS catalogue; find it:
#                            #   python -m moodle_sync plan --search "name"
# STUDY_START=2025/2026-winter  # without a catalogue: your first semester
# SEMESTER_FOLDERS=1         # "Semester N" folders (default: on with one of the two above)
# SYLLABUS=1                 # download subject cards (default: on with STUDY_PLAN_URL)

# --- cloud upload with rclone (optional; docs: storage.md) -------------------------
# RCLONE_REMOTE=gdrive        # empty = no upload
# DRIVE_DEST=Moodle           # target folder in the cloud
# KEEP_LOCAL=1                # 0 = delete local copies after upload (rclone move)
# RCLONE_BIN=rclone
# STATE_BACKUP_DEST=_moodle_sync

# --- Google Calendar (optional; docs: google-calendar.md) --------------------------
# SYNC_CLASSES=1              # 0 = don't add attendance sessions (timetable)

# --- notifications (optional, combine freely; docs: notifications.md) ---------------
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=           # set by: python -m moodle_sync bot --setup
# DISCORD_WEBHOOK_URL=
# NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=              # Gmail: an "app password", not your normal password
# EMAIL_TO=
# NOTIFY_FILES=1              # set any of these to 0 to mute that kind:
# NOTIFY_DEADLINES=1
# NOTIFY_ANNOUNCEMENTS=1
# NOTIFY_GRADES=1
# NOTIFY_ERRORS=1
# NOTIFY_SUMMARY=1
# WATCH_ALL_FORUMS=0          # 1 = all forums, not only announcements

# --- dead-man alarm (optional; docs: notifications.md) ------------------------------
# HEALTHCHECK_URL=https://hc-ping.com/your-uuid
